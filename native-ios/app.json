{
  "expo": {
    "name": "Rezepte",
    "slug": "rezepte-ios",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rezepte",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.mausbaeren.rezepte",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5C84F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sharing",
      [
        "expo-share-intent",
        {
          "disableAndroid": true,
          "iosShareExtensionName": "Rezepte teilen",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://rezepte.mausbaeren.me",
      "router": {},
      "eas": {
        "projectId": "d6c688a8-ebf1-407a-ba68-bf306ec4a423"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "oliverzimmermann1986"
  }
}
