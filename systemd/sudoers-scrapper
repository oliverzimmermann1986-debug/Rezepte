# Erlaubt dem scrapper-User systemd-Timer neu zu laden (für Schedule-Änderungen aus dem Web-UI).
# Diese Datei nach /etc/sudoers.d/scrapper kopieren (Permission 0440).

scrapper ALL=(root) NOPASSWD: /usr/bin/systemctl daemon-reload
scrapper ALL=(root) NOPASSWD: /usr/bin/systemctl restart scrapper-job.timer
scrapper ALL=(root) NOPASSWD: /usr/bin/systemctl restart rclone-sync.timer
scrapper ALL=(root) NOPASSWD: /usr/bin/systemctl start scrapper-job.timer
scrapper ALL=(root) NOPASSWD: /usr/bin/systemctl start rclone-sync.timer
scrapper ALL=(root) NOPASSWD: /usr/bin/systemctl stop scrapper-job.timer
scrapper ALL=(root) NOPASSWD: /usr/bin/systemctl stop rclone-sync.timer
