#!/usr/bin/env python3
"""Apply one tightly scoped mount/unmount action through systemd.

The unprivileged web service only writes a small request file. This root-owned
helper accepts exactly ``mount`` or ``unmount`` and operates only on the mount
point stored in the root-owned allow-file.
"""
from __future__ import annotations

import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

REQUEST = Path("/opt/scrapper/data/hdd-action.request")
RESULT = Path("/opt/scrapper/data/hdd-action.result")
ALLOW_FILE = Path("/etc/scrapper-hdd-mountpoint")
REQUEST_ID_RE = re.compile(r"^[A-Fa-f0-9-]{16,64}$")


def _atomic_result(payload: dict) -> None:
    temp_name = ""
    try:
        RESULT.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=str(RESULT.parent),
            prefix=f".{RESULT.name}.",
            delete=False,
        ) as handle:
            temp_name = handle.name
            json.dump(payload, handle, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
            os.fchown(handle.fileno(), 0, 0)
            os.fchmod(handle.fileno(), 0o644)
        os.replace(temp_name, RESULT)
    except OSError as exc:
        print(f"cannot write result file: {exc}", file=sys.stderr)
        if temp_name:
            try:
                os.unlink(temp_name)
            except OSError:
                pass


def _regular_root_file(path: Path, max_size: int) -> os.stat_result:
    st = path.lstat()
    if path.is_symlink() or not stat.S_ISREG(st.st_mode):
        raise ValueError(f"{path} must be a regular file")
    if st.st_uid != 0:
        raise ValueError(f"{path} must be root-owned")
    if st.st_mode & 0o022:
        raise ValueError(f"{path} must not be group/other writable")
    if st.st_size > max_size:
        raise ValueError(f"{path} is too large")
    return st


def _consume_request() -> tuple[str, str]:
    if len(sys.argv) != 3 or sys.argv[1] != "--request-file":
        raise ValueError("invalid invocation")
    requested = Path(sys.argv[2])
    if requested != REQUEST:
        raise ValueError("unexpected request path")
    fd = -1
    try:
        fd = os.open(requested, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > 1024:
            raise ValueError("invalid request file")
        with os.fdopen(fd, "r", encoding="utf-8") as handle:
            fd = -1
            raw = handle.read(1025)
        if len(raw.encode("utf-8")) > 1024:
            raise ValueError("invalid request file")
        data = json.loads(raw)
    finally:
        if fd >= 0:
            os.close(fd)
        requested.unlink(missing_ok=True)
    if not isinstance(data, dict):
        raise ValueError("request must be an object")
    action = str(data.get("action") or "")
    request_id = str(data.get("request_id") or "")
    if action not in {"mount", "unmount"}:
        raise ValueError("unsupported action")
    if not REQUEST_ID_RE.fullmatch(request_id):
        raise ValueError("invalid request id")
    return action, request_id


def _allowed_mount_point() -> Path:
    _regular_root_file(ALLOW_FILE, 512)
    raw = ALLOW_FILE.read_text(encoding="utf-8").strip()
    if any(ch in raw for ch in ("\x00", "\n", "\r")):
        raise ValueError("invalid mount point")
    point = Path(raw)
    if not point.is_absolute():
        raise ValueError("mount point must be absolute")
    resolved = point.resolve(strict=False)
    try:
        relative = resolved.relative_to("/mnt")
    except ValueError as exc:
        raise ValueError("mount point must be below /mnt") from exc
    if not relative.parts:
        raise ValueError("/mnt itself is not an allowed mount point")
    return resolved


def _run(command: list[str], timeout: int = 60) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def main() -> int:
    action = ""
    request_id = ""
    mount_point = ""
    try:
        if os.geteuid() != 0:
            raise ValueError("must run as root")
        action, request_id = _consume_request()
        allowed = _allowed_mount_point()
        mount_point = str(allowed)

        escaped = _run([
            "/usr/bin/systemd-escape", "--path", "--suffix=mount", mount_point,
        ], timeout=10)
        if escaped.returncode != 0:
            raise RuntimeError((escaped.stderr or escaped.stdout).strip()[:300])
        unit = escaped.stdout.strip()
        if not unit.endswith(".mount") or "/" in unit or not unit:
            raise RuntimeError("systemd produced an invalid mount unit name")

        verb = "start" if action == "mount" else "stop"
        result = _run(["/usr/bin/systemctl", verb, unit], timeout=90)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip()[:500]
            raise RuntimeError(f"systemctl {verb} {unit} failed: {detail}")

        check = _run(["/usr/bin/mountpoint", "-q", "--", mount_point], timeout=10)
        mounted = check.returncode == 0
        expected = action == "mount"
        if mounted != expected:
            raise RuntimeError(
                f"mount state verification failed (mounted={mounted}, expected={expected})"
            )

        _atomic_result({
            "ok": True,
            "action": action,
            "request_id": request_id,
            "mount_point": mount_point,
            "mounted": mounted,
            "message": "applied",
        })
        return 0
    except (OSError, UnicodeError, ValueError, RuntimeError, subprocess.TimeoutExpired) as exc:
        try:
            REQUEST.unlink(missing_ok=True)
        except OSError:
            pass
        _atomic_result({
            "ok": False,
            "action": action,
            "request_id": request_id,
            "mount_point": mount_point,
            "message": str(exc)[:500],
        })
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
