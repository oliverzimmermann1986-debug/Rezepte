[Unit]
Description=Apply one validated Scrapper HDD mount action
ConditionPathExists=/opt/scrapper/data/hdd-action.request

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/scrapper-hdd-action --request-file /opt/scrapper/data/hdd-action.request
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/scrapper-hdd-mountpoint
ReadWritePaths=/opt/scrapper/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
