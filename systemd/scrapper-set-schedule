#!/usr/bin/env python3
"""Root helper: safely update only scrapper-job.timer's OnCalendar value.

The web process never executes this helper. It writes one request file and a
root-owned systemd path unit invokes this helper. This keeps NoNewPrivileges on
the web service and avoids any sudo permission.
"""
from __future__ import annotations

import os
import json
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

TIMER = Path("/etc/systemd/system/scrapper-job.timer")
REQUEST = Path("/opt/scrapper/data/scraper-schedule.request")
RESULT = Path("/opt/scrapper/data/scraper-schedule.result")
UNIT = "scrapper-job.timer"
ALLOWED = re.compile(r"^[A-Za-z0-9:*/,\.\- ]{1,200}$")
_LAST_MESSAGE = "unknown error"
_LAST_VALUE = ""


def fail(message: str, code: int = 2) -> int:
    global _LAST_MESSAGE
    _LAST_MESSAGE = str(message)[:500]
    print(message, file=sys.stderr)
    return code


def write_result(code: int) -> None:
    """Publiziert den Apply-Status atomar für das unprivilegierte Web-UI."""
    payload = {
        "ok": code == 0,
        "value": _LAST_VALUE,
        "message": "applied" if code == 0 else _LAST_MESSAGE,
    }
    temp_name = ""
    try:
        RESULT.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=str(RESULT.parent),
            prefix=f".{RESULT.name}.", delete=False,
        ) as handle:
            temp_name = handle.name
            json.dump(payload, handle, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
            os.fchown(handle.fileno(), 0, 0)
            os.fchmod(handle.fileno(), 0o644)
        os.replace(temp_name, RESULT)
    except OSError as exc:
        print(f"cannot write result file: {exc}", file=sys.stderr)
        if temp_name:
            try:
                os.unlink(temp_name)
            except OSError:
                pass


def consume_request() -> str:
    if len(sys.argv) != 3 or sys.argv[1] != "--request-file":
        raise ValueError("usage: scrapper-set-schedule --request-file /opt/scrapper/data/scraper-schedule.request")
    requested = Path(sys.argv[2])
    if requested != REQUEST:
        raise ValueError("unexpected request path")
    fd = -1
    try:
        fd = os.open(requested, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise ValueError("request must be a regular file")
        if st.st_size > 512:
            raise ValueError("request too large")
        with os.fdopen(fd, "r", encoding="utf-8") as handle:
            fd = -1
            value = handle.read(513).strip()
        if len(value.encode("utf-8")) > 512:
            raise ValueError("request too large")
    finally:
        if fd >= 0:
            os.close(fd)
        # Always consume the trigger. Invalid input must not cause an endless path-unit loop.
        requested.unlink(missing_ok=True)
    return value


def main() -> int:
    global _LAST_VALUE
    if os.geteuid() != 0:
        return fail("must run as root")
    try:
        value = consume_request()
        _LAST_VALUE = value
    except (OSError, UnicodeError, ValueError) as exc:
        try:
            REQUEST.unlink(missing_ok=True)
        except OSError:
            pass
        return fail(str(exc))

    if not value or any(ch in value for ch in ("\n", "\r", "\x00")) or not ALLOWED.fullmatch(value):
        return fail("invalid OnCalendar expression")

    try:
        check = subprocess.run(
            ["/usr/bin/systemd-analyze", "calendar", value],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return fail(f"calendar validation failed: {exc}")
    if check.returncode != 0:
        detail = (check.stderr or check.stdout).strip()[:300]
        return fail(f"invalid OnCalendar expression: {detail}")

    try:
        st = TIMER.lstat()
    except OSError as exc:
        return fail(f"cannot stat {TIMER}: {exc}")
    if (not stat.S_ISREG(st.st_mode) or TIMER.is_symlink() or st.st_uid != 0
            or st.st_mode & 0o022):
        return fail("timer file must be a root-owned, non-writable regular file")

    try:
        lines = TIMER.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        return fail(f"cannot read timer file: {exc}")

    output: list[str] = []
    in_timer = False
    inserted = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if in_timer and not inserted:
                output.append(f"OnCalendar={value}")
                inserted = True
            in_timer = stripped == "[Timer]"
            output.append(line)
            continue
        if in_timer and re.match(r"\s*OnCalendar\s*=", line):
            if not inserted:
                output.append(f"OnCalendar={value}")
                inserted = True
            continue
        output.append(line)
    if in_timer and not inserted:
        output.append(f"OnCalendar={value}")
        inserted = True
    if not inserted:
        return fail("timer file has no [Timer] section")

    temp_name = ""
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=str(TIMER.parent),
            prefix=f".{TIMER.name}.", delete=False,
        ) as handle:
            temp_name = handle.name
            handle.write("\n".join(output) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chown(temp_name, 0, 0)
        os.chmod(temp_name, 0o644)
        os.replace(temp_name, TIMER)
        dir_fd = os.open(TIMER.parent, os.O_DIRECTORY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except OSError as exc:
        if temp_name:
            try:
                os.unlink(temp_name)
            except OSError:
                pass
        return fail(f"cannot update timer: {exc}")

    for command in (
        ["/usr/bin/systemctl", "daemon-reload"],
        ["/usr/bin/systemctl", "restart", UNIT],
    ):
        try:
            result = subprocess.run(
                command,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                timeout=30,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            return fail(f"{' '.join(command)} failed: {exc}", 1)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip()[:300]
            return fail(f"{' '.join(command)} failed: {detail}", 1)

    print(value)
    return 0


if __name__ == "__main__":
    exit_code = main()
    write_result(exit_code)
    raise SystemExit(exit_code)
