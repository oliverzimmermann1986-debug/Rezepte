[Unit]
Description=Scrapper Job (E-Mail + Link-Import)
After=network-online.target scrapper-web.service

[Service]
Type=oneshot
User=scrapper
Group=scrapper
WorkingDirectory=/opt/scrapper
Environment="PATH=/opt/scrapper/venv/bin:/usr/bin:/bin"
Environment="SCRAPPER_CONFIG=/opt/scrapper/data/config.yaml"
Environment="OMP_THREAD_LIMIT=1"
Environment="PLAYWRIGHT_BROWSERS_PATH=/opt/scrapper/playwright-browsers"
ExecStart=/opt/scrapper/venv/bin/python -m app.jobs.scraper_cli
TimeoutStartSec=3600

# Der Importjob verarbeitet fremde Dokumente und Plattformantworten. Er darf
# nur in Anwendungsdaten und konfigurierte Mounts schreiben und erhält feste
# Ressourcenobergrenzen, damit OCR/Browserfehler den Host nicht verdrängen.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/scrapper /mnt
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictSUIDSGID=true
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=200%
TasksMax=256
