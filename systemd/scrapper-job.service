[Unit]
Description=Scrapper Job (E-Mail + TikTok/Instagram Download)
After=network-online.target scrapper-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=scrapper
Group=scrapper
WorkingDirectory=/opt/scrapper
Environment="PATH=/opt/scrapper/venv/bin:/usr/bin:/bin"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="SCRAPPER_CONFIG=/opt/scrapper/data/config.yaml"
Environment="SCRAPPER_DB_PATH=/opt/scrapper/data/scrapper.db"
ExecStart=/opt/scrapper/venv/bin/python -m app.jobs.scraper_cli
TimeoutStartSec=3600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/scrapper/data /opt/scrapper/logs /opt/scrapper/temp /opt/scrapper/files -/mnt -/media -/srv
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
