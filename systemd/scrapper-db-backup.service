[Unit]
Description=Scrapper SQLite Online-Backup and Cleanup
After=scrapper-web.service

[Service]
Type=oneshot
User=scrapper
Group=scrapper
WorkingDirectory=/opt/scrapper
Environment="PATH=/opt/scrapper/venv/bin:/usr/bin:/bin"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="SCRAPPER_CONFIG=/opt/scrapper/data/config.yaml"
Environment="SCRAPPER_DB_PATH=/opt/scrapper/data/scrapper.db"
ExecStart=/opt/scrapper/venv/bin/python -m app.cli db-backup
ExecStart=/opt/scrapper/venv/bin/python -m app.cli log-cleanup
ExecStart=/bin/bash -c '[ "$(date +%%u)" = "7" ] && /opt/scrapper/venv/bin/python -m app.cli db-vacuum || true'
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/scrapper/data /opt/scrapper/logs /opt/scrapper/temp /opt/scrapper/files -/mnt -/media -/srv
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
