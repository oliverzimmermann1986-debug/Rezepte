[Unit]
Description=Scrapper SQLite Online-Backup + VACUUM + Log-Cleanup
After=scrapper-web.service

[Service]
Type=oneshot
User=scrapper
Group=scrapper
WorkingDirectory=/opt/scrapper
Environment="PATH=/opt/scrapper/venv/bin:/usr/bin:/bin"
Environment="SCRAPPER_CONFIG=/opt/scrapper/data/config.yaml"
# 1. Backup nach data/backups/{daily,weekly,monthly}/scrapper-*.db.gz
ExecStart=/opt/scrapper/venv/bin/python -m app.cli db-backup
# 2. Log-Cleanup nach paths.log_retention_days
ExecStart=/opt/scrapper/venv/bin/python -m app.cli log-cleanup
# 3. VACUUM nur sonntags (um Mehraufwand zu beschränken; das gleiche Timer
#    feuert täglich, aber VACUUM einmal pro Woche reicht)
ExecStart=/bin/bash -c '[ "$(date +%%u)" = "7" ] && /opt/scrapper/venv/bin/python -m app.cli db-vacuum || true'
TimeoutStartSec=600
