[Unit]
Description=Scrapper Web Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=scrapper
Group=scrapper
WorkingDirectory=/opt/scrapper
Environment="PATH=/opt/scrapper/venv/bin:/usr/bin:/bin"
Environment="SCRAPPER_CONFIG=/opt/scrapper/data/config.yaml"
Environment="PLAYWRIGHT_BROWSERS_PATH=/opt/scrapper/playwright-browsers"
# Sicherer Default: nur ein lokaler Reverse-Proxy darf Uvicorns Forwarded-
# Header auswerten. Bei einem separaten cloudflared-LXC exakt dessen IP in
# /opt/scrapper/data/web.env setzen, z.B.
# SCRAPPER_FORWARDED_ALLOW_IPS=192.168.1.31
Environment="SCRAPPER_FORWARDED_ALLOW_IPS=127.0.0.1"
EnvironmentFile=-/opt/scrapper/data/web.env
# Begrenzung pro OCR-Prozess; verhindert CPU-/RAM-Spitzen bei PDF-Bestandsläufen.
Environment="OMP_THREAD_LIMIT=1"
# Bind-Adresse:
#   - 127.0.0.1  wenn der Reverse-Proxy / Cloudflare-Tunnel IM SELBEN Container läuft
#   - 0.0.0.0    wenn er in einem ANDEREN Container/Host läuft und über LAN zugreift
#
# Default: 0.0.0.0, weil das die häufigere Topologie ist (Proxmox: cloudflared
# meist in eigenem LXC). Externer Schutz erfolgt über Cloudflare Access + ggf.
# eine LAN-Firewall die Port 8000 nur für die cloudflared-Container-IP öffnet.
# --proxy-headers + --forwarded-allow-ips lässt FastAPI dem CF-Tunnel die echte
# Client-IP via X-Forwarded-For/CF-Connecting-IP zuordnen.
ExecStart=/opt/scrapper/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=${SCRAPPER_FORWARDED_ALLOW_IPS}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=read-only: einige Tools (z.B. yt-dlp Cookies) lesen aus
# /home/scrapper/. ProtectHome=true wäre komplett unsichtbar - mit
# 'read-only' kann gelesen, aber nicht geschrieben werden.
ProtectHome=read-only
ReadWritePaths=/opt/scrapper /mnt
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
# Chromium/V8 benötigt ausführbaren JIT-Speicher für den optionalen
# Browser-Abruf langer TikTok-Captions.
MemoryDenyWriteExecute=false
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
