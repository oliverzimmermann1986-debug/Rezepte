[Unit]
Description=Scrapper Web Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=scrapper
Group=scrapper
WorkingDirectory=/opt/scrapper
Environment="PATH=/opt/scrapper/venv/bin:/usr/bin:/bin"
Environment="SCRAPPER_CONFIG=/opt/scrapper/data/config.yaml"
Environment="PLAYWRIGHT_BROWSERS_PATH=/opt/scrapper/playwright-browsers"
# Sicherer Default: nur ein lokaler Reverse-Proxy darf Uvicorns Forwarded-
# Header auswerten. Bei einem separaten cloudflared-LXC exakt dessen IP in
# /etc/scrapper/web.env setzen, z.B.
# SCRAPPER_FORWARDED_ALLOW_IPS=192.168.1.31
Environment="SCRAPPER_FORWARDED_ALLOW_IPS=127.0.0.1"
# Sicherer Bind-Default. Ein separater Reverse-Proxy-LXC muss Bind-Adresse,
# vertrauenswürdige Proxy-IP und eine enge Host-Firewall explizit konfigurieren.
Environment="SCRAPPER_BIND_HOST=127.0.0.1"
# Root-verwaltete Overrides kommen nach den Defaults und können beide Werte
# ersetzen, ohne dass der App-Benutzer die Proxy-Vertrauensgrenze persistiert.
EnvironmentFile=-/etc/scrapper/web.env
# Begrenzung pro OCR-Prozess; verhindert CPU-/RAM-Spitzen bei PDF-Bestandsläufen.
Environment="OMP_THREAD_LIMIT=1"
# Python wird direkt gestartet: Konsolenskripte wie `uvicorn` enthalten einen
# absoluten Venv-Shebang und brechen sonst nach dem atomaren Slot-Rename.
ExecStart=/opt/scrapper/venv/bin/python -m uvicorn app.main:app --host ${SCRAPPER_BIND_HOST} --port 8000 --proxy-headers --forwarded-allow-ips=${SCRAPPER_FORWARDED_ALLOW_IPS}
Restart=on-failure
RestartSec=5
WatchdogSec=60
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=read-only: einige Tools (z.B. yt-dlp Cookies) lesen aus
# /home/scrapper/. ProtectHome=true wäre komplett unsichtbar - mit
# 'read-only' kann gelesen, aber nicht geschrieben werden.
ProtectHome=read-only
ReadWritePaths=/opt/scrapper/data /opt/scrapper/logs /opt/scrapper/temp /opt/scrapper/files /mnt
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
# Chromium/V8 benötigt ausführbaren JIT-Speicher für den optionalen
# Browser-Abruf langer TikTok-Captions.
MemoryDenyWriteExecute=false
RestrictSUIDSGID=true
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=200%
TasksMax=512

[Install]
WantedBy=multi-user.target
