[Unit]
Description=Scrapper Web Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=scrapper
Group=scrapper
WorkingDirectory=/opt/scrapper
Environment="PATH=/opt/scrapper/venv/bin:/usr/bin:/bin"
Environment="SCRAPPER_CONFIG=/opt/scrapper/data/config.yaml"
# Bind-Adresse:
#   - 127.0.0.1  wenn der Reverse-Proxy / Cloudflare-Tunnel IM SELBEN Container läuft
#   - 0.0.0.0    wenn er in einem ANDEREN Container/Host läuft und über LAN zugreift
#
# Default: 0.0.0.0, weil das die häufigere Topologie ist (Proxmox: cloudflared
# meist in eigenem LXC). Externer Schutz erfolgt über Cloudflare Access + ggf.
# eine LAN-Firewall die Port 8000 nur für die cloudflared-Container-IP öffnet.
# --proxy-headers + --forwarded-allow-ips lässt FastAPI dem CF-Tunnel die echte
# Client-IP via X-Forwarded-For/CF-Connecting-IP zuordnen.
ExecStart=/opt/scrapper/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=read-only: einige Tools (z.B. yt-dlp Cookies) lesen aus
# /home/scrapper/. ProtectHome=true wäre komplett unsichtbar - mit
# 'read-only' kann gelesen, aber nicht geschrieben werden.
ProtectHome=read-only
ReadWritePaths=/opt/scrapper /mnt
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
