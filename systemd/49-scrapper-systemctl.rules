// Der Webdienst darf ausschließlich seinen Import-Timer neu laden und
// neu starten. Andere Units und andere systemd-Aktionen bleiben gesperrt.
polkit.addRule(function(action, subject) {
    if (subject.user !== "scrapper") {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id === "org.freedesktop.systemd1.reload-daemon") {
        return polkit.Result.YES;
    }

    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "scrapper-job.timer" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
