// Der Webdienst darf ausschließlich den root-eigenen, erneut validierenden
// Schedule-Helper starten. daemon-reload und Timerverwaltung bleiben root-only.
polkit.addRule(function(action, subject) {
    if (subject.user !== "scrapper") {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "scrapper-schedule-apply.service" &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
