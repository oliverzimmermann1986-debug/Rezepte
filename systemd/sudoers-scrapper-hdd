# /etc/sudoers.d/scrapper-hdd
#
# Erlaubt dem scrapper-User passwortlos /bin/mount und /bin/umount auf
# genau EINEM bestimmten Mount-Point auszuführen. Der Mount-Point muss
# in /etc/fstab eingetragen sein (sonst weiß mount nicht was es mounten soll).
#
# Anpassen: '/mnt/external_hdd' durch den Pfad ersetzen den du in der App
# unter external_hdd.mount_point konfiguriert hast.
#
# Installation:
#   sudo cp systemd/sudoers-scrapper-hdd /etc/sudoers.d/scrapper-hdd
#   sudo chmod 0440 /etc/sudoers.d/scrapper-hdd
#   sudo visudo -c   # Syntax-Check
#
# fstab-Beispiel:
#   UUID=xxx-xxx  /mnt/external_hdd  ext4  noauto,nofail,user  0  0
#                                              ^^^^^^ wichtig: noauto verhindert
#                                                     automatisches Mounten beim Boot

scrapper ALL=(root) NOPASSWD: /bin/mount /mnt/external_hdd
scrapper ALL=(root) NOPASSWD: /bin/umount /mnt/external_hdd
