[Unit]
Description=Apply Scrapper schedule request
ConditionPathExists=/opt/scrapper/data/scraper-schedule.request

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/scrapper-set-schedule --request-file /opt/scrapper/data/scraper-schedule.request
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/systemd/system /opt/scrapper/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
